<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketScanner.Converters"
             x:Class="MarketScanner.Views.QuoteContentView">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:ChangeToColorConverter x:Key="ChangeToColorConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.5" FalseValue="1.0"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" TrueColor="#0f0f0f" FalseColor="#1a1a1a"/>
            <converters:QuoteRowBackgroundConverter x:Key="QuoteRowBackgroundConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid x:Name="QuoteRoot"
          RowDefinitions="Auto,Auto,*" 
          Padding="10"
          BackgroundColor="{StaticResource BackgroundDark}">

        <!-- Watchlist Picker -->
        <Picker Grid.Row="0"
                ItemsSource="{Binding Watchlists}"
                SelectedItem="{Binding SelectedWatchlist, Mode=TwoWay}"
                ItemDisplayBinding="{Binding Name}"
                Title="Load from watchlist..."
                IsEnabled="{Binding HasWatchlists}"
                Margin="0,0,0,10"
                Style="{StaticResource FilterPickerStyle}"/>

        <!-- Quote Input Bar -->
        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDark}"
                BackgroundColor="{StaticResource BackgroundDark}"
                Padding="0"
                Margin="0,0,0,10"
                MinimumHeightRequest="32">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="0"
                  VerticalOptions="Start">
                
                <!-- Symbol Input with Search Results -->
                <Grid Grid.Column="0" 
                      RowDefinitions="Auto,Auto"
                      Margin="8,0,0,0">
                    <Entry x:Name="SymbolEntry"
                           Text="{Binding NewSymbolText, Mode=TwoWay}"
                           Placeholder="Enter symbol..."
                           TextChanged="OnSymbolTextChanged"
                           TextColor="{StaticResource OnSurfaceDark}"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           HeightRequest="32"
                           VerticalOptions="Center"
                           ReturnCommand="{Binding AddQuoteCommand}"
                           Unfocused="OnSymbolEntryUnfocused"/>
                    
                    <!-- Search Results Dropdown -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding ShowSearchResults}"
                            BackgroundColor="{StaticResource SurfaceDark}"
                            Stroke="{StaticResource BorderDark}"
                            StrokeThickness="1"
                            MaximumHeightRequest="200"
                            VerticalOptions="Start"
                            Margin="0,2,0,0"
                            ZIndex="1000">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4"/>
                        </Border.StrokeShape>
                        
                        <CollectionView ItemsSource="{Binding SearchResults}"
                                        SelectionMode="None"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6"
                                          ColumnDefinitions="80,*">
                                        <Grid.BackgroundColor>
                                            <MultiBinding Converter="{StaticResource SelectedItemBackgroundConverter}">
                                                <Binding Path="." />
                                                <Binding Path="BindingContext.SearchResults" Source="{x:Reference QuoteRoot}" />
                                                <Binding Path="BindingContext.SelectedSearchResultIndex" Source="{x:Reference QuoteRoot}" />
                                            </MultiBinding>
                                        </Grid.BackgroundColor>
                                        <Label Grid.Column="0"
                                               Text="{Binding Symbol}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurfaceDark}"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding Company}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariantDark}"
                                               LineBreakMode="TailTruncation"/>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.SelectSearchResultCommand, Source={x:Reference QuoteRoot}}"
                                                CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </Grid>
                
                <!-- Add Quote Button -->
                <Button Grid.Column="1"
                        Text="+"
                        Command="{Binding AddQuoteCommand}"
                        BackgroundColor="{StaticResource PrimaryDark}"
                        TextColor="{StaticResource TextOnAccent}"
                        FontSize="18"
                        FontAttributes="Bold"
                        WidthRequest="40"
                        HeightRequest="32"
                        VerticalOptions="Start"
                        HorizontalOptions="Center"
                        Padding="0"
                        CornerRadius="0"
                        BorderWidth="0"/>
                
                <!-- Clear All Button -->
                <Button Grid.Column="2"
                        Text="Clear"
                        Command="{Binding ClearQuotesCommand}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        TextColor="{StaticResource OnSurfaceDark}"
                        FontSize="12"
                        HeightRequest="32"
                        VerticalOptions="Center"
                        Padding="10,0"
                        CornerRadius="0"/>
            </Grid>
        </Border>

        <!-- Quote Grid -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource BackgroundDark}">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="100,100,80"
                  BackgroundColor="{StaticResource SurfaceDark}"
                  HeightRequest="40"
                  Padding="5,0">

                <Label Grid.Column="0" Text="Symbol" Style="{StaticResource HeaderLabel}" HorizontalOptions="Start"/>
                <Label Grid.Column="1" Text="Price" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
                <Label Grid.Column="2" Text="Change %" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End"/>
            </Grid>

            <!-- Data Rows -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding QuoteItems}"
                            BackgroundColor="#1a1a1a"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedQuoteItem, Mode=TwoWay}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="100,100,80"
                              HeightRequest="32"
                              Padding="5,0"
                              Opacity="{Binding IsDropped, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid.BackgroundColor>
                                <MultiBinding Converter="{StaticResource QuoteRowBackgroundConverter}">
                                    <Binding Path="." />
                                    <Binding Path="BindingContext.SelectedQuoteItem" Source="{x:Reference QuoteRoot}" />
                                    <Binding Path="IsDropped" />
                                </MultiBinding>
                            </Grid.BackgroundColor>

                            <!-- Right-click context menu -->
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Run Algo"
                                                    Command="{Binding BindingContext.RunAlgoCommand, Source={x:Reference QuoteRoot}}"
                                                    CommandParameter="{Binding .}" />
                                    <MenuFlyoutItem Text="Remove from Quotes"
                                                    Command="{Binding BindingContext.RemoveQuoteCommand, Source={x:Reference QuoteRoot}}"
                                                    CommandParameter="{Binding .}" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>

                            <!-- Data cells -->
                            <Label Grid.Column="0" Text="{Binding Symbol}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   Padding="6,4"/>

                            <Label Grid.Column="1" 
                                   Text="{Binding LastPrice, StringFormat='{0:C2}'}" 
                                   TextColor="{StaticResource OnSurfaceDark}" 
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>

                            <Label Grid.Column="2" 
                                   Text="{Binding ChangePercent, StringFormat='{0:+#0.00;-#0.00;0.00}%'}" 
                                   TextColor="{Binding ChangePercent, Converter={StaticResource ChangeToColorConverter}}"
                                   FontSize="13" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   Padding="6,4"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource PrimaryDark}"/>
                        <Label Text="Add symbols to compare quotes."
                               IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                               TextColor="{StaticResource ErrorColor}"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Error Message -->
        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               TextColor="{StaticResource ErrorColor}"
               VerticalOptions="End"
               HorizontalOptions="Center"
               Padding="10"
               BackgroundColor="{StaticResource SurfaceDark}"/>
    </Grid>
</ContentView>

