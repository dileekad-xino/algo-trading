<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketScanner.Converters"
             x:Class="MarketScanner.Views.DailyPlContentView">

       <ContentView.Resources>
              <ResourceDictionary>
                     <converters:ChangeToColorConverter x:Key="ChangeToColorConverter"/>
                     <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
                     <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
                     <converters:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter"/>
              </ResourceDictionary>
       </ContentView.Resources>

       <Grid x:Name="DailyPlRoot"
             RowDefinitions="Auto,Auto,*"
             Padding="10"
             BackgroundColor="{StaticResource BackgroundDark}">

              <!-- Header Section with P/L Summary and Controls -->
              <Grid Grid.Row="0"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    Padding="0,0,0,10"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    ColumnSpacing="10">

                     <!-- Total Daily P/L Display -->
                     <Grid Grid.Row="0"
                           Grid.Column="0"
                           ColumnDefinitions="Auto,*"
                           Padding="15,10,10,10"
                           Margin="0,0,0,10">
                            <Label Grid.Column="0"
                                   Text="Daily P/L:"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding TotalDailyPL, StringFormat='{0:C2}'}"
                                   TextColor="{Binding TotalDailyPL, Converter={StaticResource ChangeToColorConverter}}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   FontFamily="Cascadia Mono, Consolas, Menlo"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"/>
                     </Grid>

                     <!-- Refresh Controls -->
                     <HorizontalStackLayout Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="12"
                                            VerticalOptions="Center"
                                            HorizontalOptions="End">
                            <Button Text="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    BackgroundColor="{StaticResource PrimaryDark}"
                                    TextColor="{StaticResource TextOnAccent}"
                                    FontSize="12"
                                    WidthRequest="80"
                                    HeightRequest="32"/>

                            <!-- Keep auto-refresh controls on one horizontal baseline -->
                            <Grid ColumnDefinitions="24,Auto,Auto"
                                  ColumnSpacing="6"
                                  HeightRequest="32"
                                  Margin="0,15,0,0"
                                  VerticalOptions="Center">
                                   <CheckBox Grid.Column="0"
                                             IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                                             WidthRequest="18"
                                             HeightRequest="18"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"/>
                                   <Label Grid.Column="1"
                                          Text="Auto"
                                          TextColor="{StaticResource OnSurfaceDark}"
                                          FontSize="12"
                                          Margin="0,-15,0,0"
                                          HeightRequest="32"
                                          VerticalTextAlignment="Center"
                                          LineBreakMode="NoWrap"/>
                                   <Picker Grid.Column="2"
                                           ItemsSource="{Binding RefreshIntervals}"
                                           SelectedItem="{Binding SelectedRefreshInterval, Mode=TwoWay}"
                                           ItemDisplayBinding="{Binding Label}"
                                           WidthRequest="80"
                                           FontSize="12"
                                           TextColor="{StaticResource OnSurfaceDark}"
                                           BackgroundColor="{StaticResource BackgroundDark}"
                                           HeightRequest="32"
                                           VerticalOptions="Center"/>
                            </Grid>
                     </HorizontalStackLayout>

                     <!-- Date Picker -->
                     <DatePicker Grid.Row="1"
                                 Grid.Column="0"
                                 Date="{Binding SelectedDate, Mode=TwoWay}"
                                 TextColor="{StaticResource OnSurfaceDark}"
                                 BackgroundColor="{StaticResource BackgroundDark}"
                                 FontSize="14"
                                 HeightRequest="32"
                                 VerticalOptions="Center"/>

                     <!-- Search Input with Clear Button -->
                     <Grid Grid.Row="1"
                           Grid.Column="1"
                           ColumnDefinitions="*,Auto"
                           ColumnSpacing="5">
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource BorderDark}"
                                    BackgroundColor="{StaticResource BackgroundDark}"
                                    Padding="0"
                                    MinimumHeightRequest="32">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="4"/>
                                   </Border.StrokeShape>
                                   <Entry Text="{Binding SearchText, Mode=TwoWay}"
                                          Placeholder="Search symbol..."
                                          TextColor="{StaticResource OnSurfaceDark}"
                                          BackgroundColor="Transparent"
                                          FontSize="14"
                                          HeightRequest="32"
                                          VerticalOptions="Center"
                                          Margin="8,0"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Text="×"
                                    Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding SearchText, Converter={StaticResource StringToBoolConverter}}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource OnSurfaceDark}"
                                    FontSize="16"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    Margin="0"/>
                     </Grid>
              </Grid>

              <!-- Trades Grid -->
              <Grid Grid.Row="2"
                    RowDefinitions="Auto,*"
                    BackgroundColor="{StaticResource BackgroundDark}">

                     <!-- Header -->
                     <Grid Grid.Row="0"
                           ColumnDefinitions="80,60,100,100,80,80,80,100,100"
                           BackgroundColor="{StaticResource SurfaceDark}"
                           HeightRequest="40"
                           Padding="5,0">

                            <Label Grid.Column="0"
                                   Text="Symbol"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalOptions="Start"/>
                            <Label Grid.Column="1"
                                   Text="Status"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="2"
                                   Text="Entry Time"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="3"
                                   Text="Exit Time"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="4"
                                   Text="Entry Price"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="End"/>
                            <Label Grid.Column="5"
                                   Text="Exit Price"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="End"/>
                            <Label Grid.Column="6"
                                   Text="Quantity"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="End"/>
                            <Label Grid.Column="7"
                                   Text="P/L"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="End"/>
                            <Label Grid.Column="8"
                                   Text="P/L %"
                                   Style="{StaticResource HeaderLabel}"
                                   HorizontalTextAlignment="End"/>
                     </Grid>

                     <!-- Data Rows -->
                     <CollectionView Grid.Row="1"
                                     ItemsSource="{Binding FilteredTrades}"
                                     BackgroundColor="#1a1a1a"
                                     SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                   <DataTemplate>
                                          <Grid ColumnDefinitions="80,60,100,100,80,80,80,100,100"
                                                BackgroundColor="#1a1a1a"
                                                HeightRequest="32"
                                                Padding="5,0">

                                                 <!-- Data cells -->
                                                 <Label Grid.Column="0"
                                                        Text="{Binding Symbol}"
                                                        TextColor="{StaticResource OnSurfaceDark}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Start"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="1"
                                                        Text="{Binding StatusText}"
                                                        TextColor="{Binding IsOpen, Converter={StaticResource BoolToGreenRedConverter}}"
                                                        FontSize="12"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="Center"
                                                        FontAttributes="Bold"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="2"
                                                        Text="{Binding EntryTimeFormatted}"
                                                        TextColor="{StaticResource OnSurfaceDark}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="3"
                                                        Text="{Binding ExitTimeFormatted}"
                                                        TextColor="{StaticResource OnSurfaceDark}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="Center"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="4"
                                                        Text="{Binding EntryPriceFormatted}"
                                                        TextColor="{StaticResource OnSurfaceDark}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="End"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="5"
                                                        Text="{Binding ExitPriceFormatted}"
                                                        TextColor="{StaticResource OnSurfaceDark}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="End"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="6"
                                                        Text="{Binding Quantity, StringFormat='{0:N0}'}"
                                                        TextColor="{StaticResource OnSurfaceDark}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="End"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="7"
                                                        Text="{Binding ProfitLossFormatted}"
                                                        TextColor="{Binding ProfitLoss, Converter={StaticResource ChangeToColorConverter}}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="End"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        FontAttributes="Bold"
                                                        Padding="6,4"/>

                                                 <Label Grid.Column="8"
                                                        Text="{Binding ProfitLossPercentFormatted}"
                                                        TextColor="{Binding ProfitLossPercent, Converter={StaticResource ChangeToColorConverter}}"
                                                        FontSize="13"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="End"
                                                        FontFamily="Cascadia Mono, Consolas, Menlo"
                                                        FontAttributes="Bold"
                                                        Padding="6,4"/>
                                          </Grid>
                                   </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                   <StackLayout VerticalOptions="CenterAndExpand"
                                                HorizontalOptions="CenterAndExpand">
                                          <ActivityIndicator IsRunning="{Binding IsLoading}"
                                                             IsVisible="{Binding IsLoading}"
                                                             Color="{StaticResource PrimaryDark}"/>
                                          <Label Text="No trades found for selected date."
                                                 IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                                 TextColor="{StaticResource OnSurfaceVariantDark}"
                                                 HorizontalOptions="Center"
                                                 Margin="0,10,0,0"/>
                                   </StackLayout>
                            </CollectionView.EmptyView>
                     </CollectionView>
              </Grid>

              <!-- Error Message -->
              <Label Grid.Row="2"
                     Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                     TextColor="{StaticResource ErrorColor}"
                     VerticalOptions="End"
                     HorizontalOptions="Center"
                     Padding="10"
                     BackgroundColor="{StaticResource SurfaceDark}"/>
       </Grid>
</ContentView>

