<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketScanner.Converters"
             xmlns:models="clr-namespace:MarketScanner.Models"
             x:Class="MarketScanner.Views.AlgoRunnerPage"
             Title="Algorithm Runner"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:ChangeToColorConverter x:Key="ChangeToColorConverter"/>
            <converters:AlgoActionToColorConverter x:Key="AlgoActionToColorConverter"/>
            <converters:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter"/>
            <converters:RsiSignalToColorConverter x:Key="RsiSignalToColorConverter"/>
            <converters:CciSignalToColorConverter x:Key="CciSignalToColorConverter"/>
            <converters:NullableDoubleToBoolConverter x:Key="NullableDoubleToBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Orientation="Vertical">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" 
              Padding="20"
              BackgroundColor="{StaticResource BackgroundDark}">

        <!-- Symbol Information -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDark}"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="15"
                Margin="0,0,0,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="Symbol:"
                       TextColor="{StaticResource OnSurfaceVariantDark}"
                       FontSize="14"
                       VerticalOptions="Center"
                       Margin="0,0,10,0"/>
                <Label Grid.Column="1"
                       Text="{Binding SelectedSymbol.Symbol}"
                       TextColor="{StaticResource OnSurfaceDark}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Price Information -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="15"
              Margin="0,0,0,15">
            <Border Grid.Column="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Current Price"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"/>
                    <Label Text="{Binding SelectedSymbol.LastPrice, StringFormat='{0:C2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Change %"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"/>
                    <Label Text="{Binding SelectedSymbol.ChangePercent, StringFormat='{0:+#0.00;-#0.00;0.00}%'}"
                           TextColor="{Binding SelectedSymbol.ChangePercent, Converter={StaticResource ChangeToColorConverter}}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Quantity"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"/>
                    <Entry Text="{Binding Quantity}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           Placeholder="100"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Result Display -->
        <Border Grid.Row="2"
                StrokeThickness="2"
                Stroke="{Binding Result.Action, Converter={StaticResource AlgoActionToColorConverter}}"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="20"
                Margin="0,0,0,15"
                IsVisible="{Binding Result, Converter={StaticResource StringToBoolConverter}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            
            <VerticalStackLayout Spacing="15">
                <!-- Action Indicator -->
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="Action:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.Action}"
                           TextColor="{Binding Result.Action, Converter={StaticResource AlgoActionToColorConverter}}"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Suggested Price -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding Result.Price, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="Suggested Price:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.Price, StringFormat='{0:C2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- RSI Value (Live updates on every tick) -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding LiveRsiValue, Converter={StaticResource NullableDoubleToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="RSI:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding LiveRsiValue, StringFormat='{0:F2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- RSI Signal -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding Result.RsiSignal, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="RSI Signal:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.RsiSignal}"
                           TextColor="{Binding Result.RsiSignal, Converter={StaticResource RsiSignalToColorConverter}}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- CCI Value (Live updates on every tick) -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding LiveCciValue, Converter={StaticResource NullableDoubleToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="CCI:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding LiveCciValue, StringFormat='{0:F2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- CCI Signal -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding Result.CciSignal, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="CCI Signal:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.CciSignal}"
                           TextColor="{Binding Result.CciSignal, Converter={StaticResource CciSignalToColorConverter}}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Reason -->
                <Grid RowDefinitions="Auto,*"
                      IsVisible="{Binding Result.Reason, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Row="0"
                           Text="Reason:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                    <Label Grid.Row="1"
                           Text="{Binding Result.Reason}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="13"
                           LineBreakMode="WordWrap"/>
                </Grid>

                <!-- MACD Indicator Section -->
                <BoxView HeightRequest="1" 
                         BackgroundColor="{StaticResource BorderDark}" 
                         Margin="0,10"/>
                
                <Label Text="MACD Indicator"
                       TextColor="{StaticResource OnSurfaceVariantDark}"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="0,0,0,8"/>
                
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="15">
                    <!-- MACD Line (12) -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="MACD (12)"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="11"/>
                        <Label Text="{Binding MacdLine, StringFormat='{0:F4}'}"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="13"
                               FontFamily="Cascadia Mono, Consolas, Menlo"/>
                    </VerticalStackLayout>
                    
                    <!-- Signal Line (26) -->
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Signal (26)"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="11"/>
                        <Label Text="{Binding SignalLine, StringFormat='{0:F4}'}"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="13"
                               FontFamily="Cascadia Mono, Consolas, Menlo"/>
                    </VerticalStackLayout>
                    
                    <!-- Histogram -->
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Histogram"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="11"/>
                        <Label Text="{Binding Histogram, StringFormat='{0:+0.0000;-0.0000;0.0000}'}"
                               TextColor="{Binding IsHistogramPositive, Converter={StaticResource BoolToGreenRedConverter}}"
                               FontSize="13"
                               FontFamily="Cascadia Mono, Consolas, Menlo"/>
                    </VerticalStackLayout>
                    
                    <!-- Crossover Status -->
                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="Crossover"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="11"/>
                        <Label Text="{Binding CrossoverStatus}"
                               FontSize="13"
                               FontFamily="Cascadia Mono, Consolas, Menlo">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasCrossedUp}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PositiveGreen}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding HasCrossedDown}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource NegativeRed}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <!-- P/L Section -->
                <BoxView HeightRequest="1" 
                         BackgroundColor="{StaticResource BorderDark}" 
                         Margin="0,10"/>
                
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">
                    <!-- Position Value -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Position Value"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="12"/>
                        <Label Text="{Binding PositionValue, StringFormat='{0:C2}'}"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="14"
                               FontFamily="Cascadia Mono, Consolas, Menlo"/>
                    </VerticalStackLayout>
                    
                    <!-- P/L Dollar -->
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="P/L"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="12"/>
                        <Label Text="{Binding ProfitLoss, StringFormat='{0:+$#,##0.00;-$#,##0.00;$0.00}'}"
                               TextColor="{Binding ProfitLoss, Converter={StaticResource ChangeToColorConverter}}"
                               FontSize="14"
                               FontFamily="Cascadia Mono, Consolas, Menlo"/>
                    </VerticalStackLayout>
                    
                    <!-- P/L Percent -->
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="P/L %"
                               TextColor="{StaticResource OnSurfaceVariantDark}"
                               FontSize="12"/>
                        <Label Text="{Binding ProfitLossPercent, StringFormat='{0:+#0.00;-#0.00;0.00}%'}"
                               TextColor="{Binding ProfitLossPercent, Converter={StaticResource ChangeToColorConverter}}"
                               FontSize="14"
                               FontFamily="Cascadia Mono, Consolas, Menlo"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- P/L Calculation Formula -->
                <Label Text="{Binding PlCalculation}"
                       TextColor="{StaticResource OnSurfaceVariantDark}"
                       FontSize="11"
                       FontFamily="Cascadia Mono, Consolas, Menlo"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"
                       IsVisible="{Binding HasPosition}"/>

                <!-- Entry/Exit Price (if position exists) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" 
                      IsVisible="{Binding HasPosition}"
                      Margin="0,10,0,0"
                      ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="Entry:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding EntryPrice, StringFormat='{0:C2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="12"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="2"
                           Text="Exit:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"
                           VerticalOptions="Center"
                           IsVisible="{Binding PositionClosed}"/>
                    <Label Grid.Column="3"
                           Text="{Binding ExitPrice, StringFormat='{0:C2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="12"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"
                           IsVisible="{Binding PositionClosed}"/>
                    <Button Grid.Column="5"
                            Text="Reset"
                            Command="{Binding ResetPositionCommand}"
                            BackgroundColor="{StaticResource SurfaceDark}"
                            TextColor="{StaticResource OnSurfaceVariantDark}"
                            FontSize="11"
                            HeightRequest="28"
                            Padding="10,0"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Error Message -->
        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               TextColor="{StaticResource ErrorColor}"
               FontSize="13"
               Margin="0,0,0,15"
               LineBreakMode="WordWrap"/>

        <!-- Buttons -->
        <Grid Grid.Row="4"
              ColumnDefinitions="*,*"
              ColumnSpacing="15">
            <!-- Run Algorithm button - visible when NOT running -->
            <Button Grid.Column="0"
                    Text="Run Algorithm"
                    Command="{Binding RunAlgoCommand}"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    TextColor="{StaticResource TextOnAccent}"
                    IsVisible="{Binding IsRunning, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="40"/>
            <!-- Stop Algorithm button - visible when running -->
            <Button Grid.Column="0"
                    Text="Stop Algorithm"
                    Command="{Binding StopAlgoCommand}"
                    BackgroundColor="#EF5350"
                    TextColor="White"
                    IsVisible="{Binding IsRunning}"
                    HeightRequest="40"/>
            <Button Grid.Column="1"
                    Text="Close"
                    Command="{Binding CloseCommand}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    TextColor="{StaticResource OnSurfaceDark}"
                    HeightRequest="40"/>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="5"
                           IsRunning="{Binding IsRunning}"
                           IsVisible="{Binding IsRunning}"
                           Color="{StaticResource PrimaryDark}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
        </Grid>
    </ScrollView>
</ContentPage>

