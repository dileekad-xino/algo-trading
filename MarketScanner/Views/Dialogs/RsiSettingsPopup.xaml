<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="MarketScanner.Views.Dialogs.RsiSettingsPopup"
               Color="#B3000000">
    <toolkit:Popup.Resources>
        <Style x:Key="PopupSecondaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="16,8"/>
            <Setter Property="HeightRequest"
                    Value="44"/>
            <Setter Property="MinimumHeightRequest"
                    Value="44"/>
            <Setter Property="VerticalOptions"
                    Value="Center"/>
        </Style>
        <Style x:Key="PopupPrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="16,8"/>
            <Setter Property="HeightRequest"
                    Value="44"/>
            <Setter Property="MinimumHeightRequest"
                    Value="44"/>
            <Setter Property="VerticalOptions"
                    Value="Center"/>
        </Style>
    </toolkit:Popup.Resources>
    <Border BackgroundColor="{StaticResource BackgroundDark}"
            Stroke="{StaticResource BorderDark}"
            StrokeThickness="1"
            Padding="20"
            WidthRequest="600"
            MaximumWidthRequest="700"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8"/>
        </Border.StrokeShape>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="16"
              MinimumHeightRequest="580">
            <Label Text="RSI Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurfaceDark}"/>

            <Border Grid.Row="1"
                    Stroke="{StaticResource BorderDark}"
                    StrokeThickness="1"
                    Padding="16"
                    BackgroundColor="{StaticResource SurfaceDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="20"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="16"
                      MinimumHeightRequest="500">
                    <!-- Left Column: RSI Parameters -->
                    <VerticalStackLayout Grid.Column="0" Spacing="16">
                        <Label Text="RSI Parameters"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,0,0,4"/>
                        
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Text="Length"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="PeriodEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Text="Oversold"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="OversoldEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Text="Overbought"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="OverboughtEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Text="Historical Days"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="DaysEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Right Column: Risk Management & Trailing Stop -->
                    <VerticalStackLayout Grid.Column="1" Spacing="16">
                        <Label Text="Risk Management"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,0,0,4"/>
                        
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Label Text="Initial Stop-Loss"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="InitialStopLossEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                            <Label Text="%"
                                   Grid.Column="2"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   Margin="5,0,0,0"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" 
                                 BackgroundColor="{StaticResource BorderDark}" 
                                 Margin="0,8"/>
                        
                        <Label Text="Trailing Stop"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,4,0,4"/>
                        
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label Text="Mode"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Picker x:Name="TrailingStopModePicker"
                                    Grid.Column="1"
                                    Title="Select mode"
                                    TextColor="{StaticResource OnSurfaceDark}"
                                    BackgroundColor="{StaticResource SurfaceDark}">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Percentage</x:String>
                                        <x:String>Price</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Grid>
                        
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Label Text="Distance"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="TrailingStopDistanceEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                            <Label x:Name="TrailingStopUnitLabel"
                                   Grid.Column="2"
                                   Text="%"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   Margin="5,0,0,0"/>
                        </Grid>
                        
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Label Text="Activation Price"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"/>
                            <Entry x:Name="ActivationPriceEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Style="{StaticResource FilterEntryStyle}"/>
                            <Label Text="%"
                                   Grid.Column="2"
                                   TextColor="{StaticResource OnSurfaceDark}"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="12"
                  Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Defaults"
                        Style="{StaticResource PopupSecondaryActionButtonStyle}"
                        Clicked="OnDefaultsClicked"
                        MinimumWidthRequest="80"
                        HorizontalOptions="Start"/>
                <Button Grid.Column="2"
                        Text="Cancel"
                        Style="{StaticResource PopupSecondaryActionButtonStyle}"
                        Clicked="OnCancelClicked"
                        MinimumWidthRequest="80"
                        HorizontalOptions="End"/>
                <Button Grid.Column="3"
                        Text="Ok"
                        Style="{StaticResource PopupPrimaryActionButtonStyle}"
                        Clicked="OnOkClicked"
                        MinimumWidthRequest="80"
                        HorizontalOptions="End"/>
            </Grid>

            <Label Grid.Row="3"
                   x:Name="ErrorLabel"
                   TextColor="{StaticResource ErrorColor}"
                   FontSize="12"
                   IsVisible="False"/>
        </Grid>
    </Border>
</toolkit:Popup>

