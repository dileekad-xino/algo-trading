<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="MarketScanner.Views.Dialogs.AlgoRunnerSettingsPopup"
               Color="#B3000000">
    <toolkit:Popup.Resources>
        <Style x:Key="PopupSecondaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="16,8"/>
            <Setter Property="HeightRequest"
                    Value="44"/>
            <Setter Property="MinimumHeightRequest"
                    Value="44"/>
            <Setter Property="VerticalOptions"
                    Value="Center"/>
        </Style>
        <Style x:Key="PopupPrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="16,8"/>
            <Setter Property="HeightRequest"
                    Value="44"/>
            <Setter Property="MinimumHeightRequest"
                    Value="44"/>
            <Setter Property="VerticalOptions"
                    Value="Center"/>
        </Style>
    </toolkit:Popup.Resources>
    <Border BackgroundColor="{StaticResource BackgroundDark}"
            Stroke="{StaticResource BorderDark}"
            StrokeThickness="1"
            Padding="20"
            WidthRequest="700"
            MaximumWidthRequest="840"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8"/>
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
              RowSpacing="14"
              MinimumHeightRequest="620">
            <Label x:Name="TitleLabel"
                   Text="Algo Runner Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurfaceDark}"/>

            <HorizontalStackLayout x:Name="TabHeaderHost"
                                   Grid.Row="1"
                                   Spacing="8"/>

            <Border Grid.Row="2"
                    Stroke="{StaticResource BorderDark}"
                    StrokeThickness="1"
                    Padding="14"
                    BackgroundColor="{StaticResource SurfaceDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6"/>
                </Border.StrokeShape>
                <ContentView x:Name="TabContentHost"/>
            </Border>

            <Grid Grid.Row="3"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Defaults"
                        Style="{StaticResource PopupSecondaryActionButtonStyle}"
                        Clicked="OnDefaultsClicked"
                        MinimumWidthRequest="80"
                        HorizontalOptions="Start"/>
                <Button Grid.Column="2"
                        Text="Cancel"
                        Style="{StaticResource PopupSecondaryActionButtonStyle}"
                        Clicked="OnCancelClicked"
                        MinimumWidthRequest="80"
                        HorizontalOptions="End"/>
                <Button Grid.Column="3"
                        Text="Ok"
                        Style="{StaticResource PopupPrimaryActionButtonStyle}"
                        Clicked="OnOkClicked"
                        MinimumWidthRequest="80"
                        HorizontalOptions="End"/>
            </Grid>

            <Label Grid.Row="4"
                   x:Name="ErrorLabel"
                   TextColor="{StaticResource ErrorColor}"
                   FontSize="12"
                   IsVisible="False"/>
        </Grid>
    </Border>
</toolkit:Popup>
